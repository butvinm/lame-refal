*$FROM Canvas
$EXTERN FillRect, SetFillStyle;

/*
  Элементарный клеточный автомат, правило 110.

    <Arg 0>   текущее поколение из литер '0' и '1'
    <Arg 1>   номер строки, в которую его рисовать
    <Arg 2>   цвет живой клетки

  Программа рисует полученное поколение и печатает следующее.
  Состояние живёт на стороне JS: память рефал-машины сбрасывается
  перед каждым запуском, поэтому поколение приходит через argv,
  а возвращается через стандартный вывод.
*/
$ENTRY Go {
  =
    <SetFillStyle <Arg 2>>
    <DrawRow <Numb <Arg 1>> 0 <Arg 0>>
    <Prout <Next <Arg 0>>>;
}

CellSize { = 5 }

/* Правило 110 целиком: восемь окрестностей и восемь предложений. */
Rule {
  '111' = '0';
  '110' = '1';
  '101' = '1';
  '100' = '0';
  '011' = '1';
  '010' = '1';
  '001' = '1';
  '000' = '0';
}

/* Лента замкнута в кольцо: соседи крайних клеток лежат на другом конце. */
Next {
  s.First e.Middle s.Last =
    <Slide s.Last s.First e.Middle s.Last s.First>;
}

/* Окно шириной в три клетки едет по ленте и оставляет за собой новую. */
Slide {
  s.L s.C s.R = <Rule s.L s.C s.R>;
  s.L s.C s.R e.Rest = <Rule s.L s.C s.R> <Slide s.C s.R e.Rest>;
}

DrawRow {
  s.Row s.Col = ;

  s.Row s.Col '1' e.Rest =
    <FillRect
      <Mul (s.Col) <CellSize>>
      <Mul (s.Row) <CellSize>>
      <CellSize>
      <CellSize>
    >
    <DrawRow s.Row <Add (s.Col) 1> e.Rest>;

  s.Row s.Col '0' e.Rest =
    <DrawRow s.Row <Add (s.Col) 1> e.Rest>;
}
