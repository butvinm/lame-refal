*$FROM Canvas
$EXTERN SetFillStyle;
$EXTERN BeginPath;
$EXTERN Fill;
$EXTERN Arc;

*$FROM LibraryEx
$EXTERN Map;
$EXTERN Trim;

*$FROM FPF
$EXTERN FPF-ToInt;

*$FROM Interpolation
$EXTERN Linear;
$EXTERN Lagrange;

/*
    <Arg 0>   абсцисса, в которой считаем значения
    <Arg 1>   узлы, по строке "x;y" на каждый
    <Arg 2>   цвет узлов
    <Arg 3>   цвет многочлена Лагранжа
    <Arg 4>   цвет ломаной
*/
$ENTRY Go {
  =
    <Next
      (<JSFloatToFF <Arg 0>>)
      <ParsePoints <Arg 1>>
    >;
}

ParsePoints {
  e.Points = <Map (ParseRow) <Split '\n' <Trim e.Points>>>;
}

$ENTRY ParseRow {
  (e.Row) = (<Map JSFloatToFF-Bracketed <Split ';' e.Row>>);
}

Split {
  s.Del e.StrB s.Del e.StrE = (e.StrB) <Split s.Del e.StrE>;
  s.Del e.Str = (e.Str);
}

$ENTRY JSFloatToFF-Bracketed {
  (e.Float) = (<JSFloatToFF e.Float>);
}

JSFloatToFF {
  e.Int '.' s.F0 s.F1 s.F2 e.Rest = <Numb e.Int s.F0 s.F1 s.F2>;
  e.Int '.' s.F0 s.F1 = <Numb e.Int s.F0 s.F1 '0'>;
  e.Int '.' s.F0 = <Numb e.Int s.F0 '0' '0'>;
  e.Int = <Numb e.Int '0' '0' '0'>;
}


NodeRadius { = 9 }
TraceRadius { = 4 }

Next {
  (e.X) e.Points =
    <SetFillStyle <Arg 2>> <Map (DrawPoint <NodeRadius>) e.Points>
    <SetFillStyle <Arg 3>> <DrawPoint <TraceRadius> ((e.X) (<Lagrange (e.X) e.Points>))>
    <SetFillStyle <Arg 4>> <DrawPoint <TraceRadius> ((e.X) (<Linear (e.X) e.Points>))>;
}



ToCanvasCenterX { e.A = <Add (e.A) 500> }
ToCanvasCenterY { e.A = <Sub 500 e.A> }
CanvasScale { e.A = <Mul (e.A) 50> }

$ENTRY DrawPoint {
  s.R ((e.X) (e.Y)) =
    <BeginPath>
    <Arc
      (<ToCanvasCenterX <FPF-ToInt <CanvasScale e.X>>>)
      (<ToCanvasCenterY <FPF-ToInt <CanvasScale e.Y>>>)
      s.R 0 7 0
    >
    <Fill>;
}
